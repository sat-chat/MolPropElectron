{
  "name": "molprop-electron",
  "version": "0.1.0",
  "description": "MolProp Electron App",
  "author": "Satadru",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "26.2.0",
    "electron-builder": "24.6.0"
  },
  
    "extraResources": [
      "../models/**"
    ]
  }
,
"build": {
  "appId": "com.genexis.molprop",
  "productName": "MolPropElectron",
  "files": [
    "../react_frontend/dist/**",
    "../molecule_api_full.exe",
    "../models/**",
    "**/*"
  ],
  "extraResources": [
    "../models/**",
    "../molecule_api_full.exe"
  ],
  "asar": true,
  "win": {
    "target": [
      "portable"
    ],
    "artifactName": "${productName}-${version}-portable.${ext}"
  },
  "directories": {
    "buildResources": "build"
  }
}
}
